# ==============================================================================
# Universal Complaint Management System - Environment Configuration
# ==============================================================================

# Project
PROJECT_NAME="Universal Complaint Management System"
API_V1_STR="/api/v1"

# Security (Generate a secure random string in production: openssl rand -hex 32)
SECRET_KEY="super-secret-key-change-this-in-production-use-a-strong-random-hex-string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL 14+)
# For local script environment:
DATABASE_URL="postgresql+psycopg2://postgres@localhost:5434/complaint_db"
# For Docker Compose:
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@postgres:5432/complaint_db"

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["*"]

# File Storage
MAX_UPLOAD_SIZE_MB=10

# AI Provider Configuration
# Supported providers: "local_fallback" (Zero-config offline NLP), "gemini", "openai"
AI_PROVIDER="local_fallback"
# AI_API_KEY="your-google-gemini-or-openai-api-key"
AI_MODEL_NAME="gemini-1.5-flash"

# Email Notifications (Optional - SMTP)
EMAILS_ENABLED=false
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="noreply@complaintsystem.org"
